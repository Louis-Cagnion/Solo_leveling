# Copier ce fichier en `.env` (ignoré par Git) puis renseigner les valeurs.
# Dossier du suivi de /professor (obligatoire, doit exister).
PROFESSOR_SUIVI_DIR=
# Fichier historique-ia.csv (obligatoire).
IA_HISTORY_CSV=
# Identifiant et secret de l'application OAuth 42 (facultatifs sans l'API).
API42_CLIENT_ID=
API42_CLIENT_SECRET=
# Port local du retour OAuth, entre 1024 et 65535.
API42_CALLBACK_PORT=
